# --- Required ---
# Postgres with the pgvector extension (Neon, Supabase, or AWS Aurora)
DATABASE_URL=postgresql://user:password@host:5432/bindbench

# Protects the /api/screens/poll cron endpoint (generate: openssl rand -hex 32)
CRON_SECRET=

# --- Optional: Boltz API ---
# Keep BOLTZ_MOCK=true to run the full prediction loop with deterministic
# fake results and zero API cost. Set to false and add a key for live predictions.
BOLTZ_MOCK=true
# BOLTZ_API_KEY=
# BOLTZ_BASE_URL=https://api.boltz.bio
# BOLTZ_AUTH_STYLE=bearer

# --- Optional: Pendo analytics ---
# NEXT_PUBLIC_PENDO_API_KEY=
# PENDO_TRACK_EVENT_SECRET=
